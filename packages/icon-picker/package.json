{
  "name": "@hellomoksedul/icon-store",
  "version": "0.1.0",
  "private": false,
  "description": "A fully customizable, headless icon picker for React & Next.js. Browse 40k+ react-icons across all icon sets, or insert your own custom SVG by upload or code. Elementor-style icon library with a media-uploader-style picker field.",
  "author": "Moksedul Islam <hello@moksedul.com>",
  "license": "MIT",
  "homepage": "https://icon-store.moksedul.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/hellomoksedul/icon-store.moksedul.com.git"
  },
  "bugs": {
    "url": "https://github.com/hellomoksedul/icon-store.moksedul.com/issues"
  },
  "keywords": [
    "icon-picker",
    "icon-store",
    "icon-library",
    "react-icons",
    "svg-icon",
    "custom-svg",
    "react",
    "nextjs",
    "tailwindcss",
    "headless",
    "elementor"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-styles.js && tsup src/index.ts --format cjs,esm --dts",
    "dev": "node scripts/build-styles.js && tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-tabs": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "radix-ui": "^1.0.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^2.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}

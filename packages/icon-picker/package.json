{
  "name": "@hellomoksedul/icon-picker",
  "version": "1.0.3",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i src/index.css -o dist/index.css && node scripts/build-css.js",
    "build:js": "tsup",
    "build": "pnpm run build:css && pnpm run build:js",
    "dev": "tsup --watch",
    "lint": "eslint src/"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
